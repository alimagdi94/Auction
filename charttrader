void TogglePanel() {
   IsPanelVisible = !IsPanelVisible;
   
   // Reset drag state on toggle
   if(g_IsDragging) {
      g_IsDragging = false;
      ChartSetInteger(0, CHART_MOUSE_SCROLL, g_ChartScrollSaved);
   }
   
   if(IsPanelVisible) { 
      CreateGUI(); 
      UpdateToggleState(); 
      UpdateCalculatedLot();
      DrawVisualLines(true); 
      ChartRedraw(); 
   }
   else { 
      DeleteAllPrefixObjs(); 
      ChartRedraw(); 
   }
}

