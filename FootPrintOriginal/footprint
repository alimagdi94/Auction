void ObjectInitRect(string name, int zorder=0) {
    ObjectCreate(g_chart, name, OBJ_RECTANGLE_LABEL, g_sub, 0, 0);
    ObjectSetInteger(g_chart, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
