//+------------------------------------------------------------------+
//| Strict Ladder Render                                             |
//+------------------------------------------------------------------+
void Render()
  {
   if(!g_visible || ArraySize(g_bars) == 0) return;
   
   int cw = (int)ChartGetInteger(g_chart, CHART_WIDTH_IN_PIXELS);
   int ch = (int)ChartGetInteger(g_chart, CHART_HEIGHT_IN_PIXELS);
   if(cw <= 0 || ch <= 0) return;

   int firstVis = (int)ChartGetInteger(g_chart, CHART_FIRST_VISIBLE_BAR);
   int visBars  = (int)ChartGetInteger(g_chart, CHART_VISIBLE_BARS);
   if(visBars < 1) visBars = 1;
   
   LayoutUIControls(cw, ch);
   DrawUI();

   ResetPool();
   g_sepActive = 0;
   g_stackActive = 0;
   g_outlineActive = 0;
   g_centerLineActive = 0;
   InitStackPool(InpMaxBarsToRender * 12);
   InitOutlinePool(InpMaxBarsToRender);
   InitCenterLinePool(InpMaxBarsToRender);

   // Draw from left to right so rightmost (most recent) bars are drawn last and visible on top
   int rightmostShift = firstVis - visBars + 1;
   if(rightmostShift < 0) rightmostShift = 0;
   int maxBars = MathMin(visBars, InpMaxBarsToRender);
   const int rightMarginPx = 12;

   for(int v = maxBars - 1; v >= 0; v--)
     {
      int shift = rightmostShift + v;
      if(shift > firstVis || shift < 0) continue;

      datetime bt = iTime(_Symbol, PERIOD_CURRENT, shift);
      int bi = FindBarIndex(bt);
      if(bi < 0 || g_bars[bi].level_count == 0) continue;

      ComputeBarSignals(bi);

      // Strict fixed width; columns drawn right-to-left with fixed gap (detached from candle X)
      int barWidthPx = InpBarWidthPx;
      int barsFromRight = maxBars - 1 - v;
      int x_left = cw - rightMarginPx - barWidthPx - barsFromRight * (InpBarWidthPx + InpBarGapPx);

      if(x_left > cw || x_left + barWidthPx < 0) continue;

      // PASS 2: top = ceil(High/step)*step, bot = floor(Low/step)*step (padded)
      double topStep = MathCeil(g_bars[bi].high / g_step) * g_step + g_step * InpVerticalPadRows;
      double botStep = MathFloor(g_bars[bi].low / g_step) * g_step - g_step * InpVerticalPadRows;
      int stepsNum = (int)MathRound((topStep - botStep) / g_step) + 1;

      // Strict ladder: anchor Y from bar midPrice, fixed row height in pixels (no chart-scale squeeze)
      double midPrice = NormP((g_bars[bi].high + g_bars[bi].low) / 2.0);
      int tmpX, anchorY;
      if(!ChartTimePriceToXY(g_chart, g_sub, bt, midPrice, tmpX, anchorY)) continue;

      long maxTotal = 1;
      for(int i = 0; i < g_bars[bi].level_count; i++) {
         if(g_bars[bi].levels[i].total_vol > maxTotal) maxTotal = g_bars[bi].levels[i].total_vol;
      }

      int colHeightPx = stepsNum * InpRowHeightPx;
      int y_top_first = anchorY - (int)MathRound((topStep - midPrice) / g_step) * InpRowHeightPx + g_yOffsetPx - InpRowHeightPx / 2;
      DrawBarOutline(x_left, y_top_first, barWidthPx, colHeightPx);

      int y_tops[]; int lvl_indices[];
      ArrayResize(y_tops, stepsNum);
      ArrayResize(lvl_indices, stepsNum);
      for(int k = 0; k < stepsNum; k++) lvl_indices[k] = -1;

      int y_top_first_actual = 0;
      for(int i = 0; i < stepsNum; i++)
        {
         double price = topStep - i * g_step;
         int diffSteps = (int)MathRound((price - midPrice) / g_step);
         int y_center = anchorY - diffSteps * InpRowHeightPx + g_yOffsetPx;
         int y_top = y_center - InpRowHeightPx / 2;
         if(i == 0) y_top_first_actual = y_top;
         y_tops[i] = y_top;
         if(y_top > ch || y_top + InpRowHeightPx < 0) continue;

         PriceLevel pl;
         ZeroMemory(pl);
         bool found = false;
         int lvlIdx = -1;
         for(int j = 0; j < g_bars[bi].level_count; j++) {
            if(MathAbs(g_bars[bi].levels[j].price - price) < g_step * 0.4) {
               pl = g_bars[bi].levels[j];
               found = true;
               lvlIdx = j;
               break;
            }
         }

         long bV = found ? pl.bid_vol : 0;
         long aV = found ? pl.ask_vol : 0;

         // Light theme: black text; empty = beige/cream; bearish = pastel red, bullish = pastel green
         color bgCol     = InpEmptyCellColor;
         color borderCol = InpGridLineColor;
         color bidTxtCol = clrBlack;
         color askTxtCol = clrBlack;
         int   borderW   = 1;

         string sBid = " ";
         string sAsk = " ";

         if(found && (bV > 0 || aV > 0)) {
            sBid = IntegerToString(bV);
            sAsk = IntegerToString(aV);
            if(g_mode == FOOT_CHART_VOLUME && bV == 0 && aV == 0) { sBid = " "; sAsk = " "; }

            bool inVA = (lvlIdx >= g_bars[bi].va_lo_idx && lvlIdx <= g_bars[bi].va_hi_idx);
            double intensity = (maxTotal > 0) ? (double)pl.total_vol / (double)maxTotal : 0.0;

            // Cell background: light pastel red for bearish delta, light pastel green for bullish/VA
            if(pl.delta < 0)
               bgCol = LerpColorOpaque(InpEmptyCellColor, InpBearishCellColor, MathMin(1.0, intensity + 0.3));
            else
               bgCol = LerpColorOpaque(InpEmptyCellColor, inVA ? InpBullishCellColor : InpOutOfVAColor, MathMin(1.0, intensity + 0.2));

            // Imbalances & POC: thick borders only, no solid fills (transparent inner)
            if(pl.is_imb_sell)       { borderCol = InpImbSellColor; borderW = 3; }
            else if(pl.is_imb_buy)  { borderCol = InpImbBuyColor;  borderW = 3; }

            if(pl.is_stacked_imb_sell) { borderCol = InpStackedSellColor; borderW = 3; }
            else if(pl.is_stacked_imb_buy) { borderCol = InpStackedBuyColor; borderW = 3; }
            if(lvlIdx == g_bars[bi].poc_idx) { borderCol = InpPOCColor; borderW = 3; }
         }
         lvl_indices[i] = found ? lvlIdx : -1;

         DrawGridCell(x_left, y_top, barWidthPx, sBid, sAsk, bgCol, borderCol, bidTxtCol, askTxtCol, borderW);
        }

      // Stacked imbalance: ONE rectangle around each run of N consecutive rows (task)
      for(int runStart = 0; runStart < stepsNum; ) {
         int li = lvl_indices[runStart];
         bool isSell = (li >= 0 && li < g_bars[bi].level_count && g_bars[bi].levels[li].is_stacked_imb_sell);
         bool isBuy  = (li >= 0 && li < g_bars[bi].level_count && g_bars[bi].levels[li].is_stacked_imb_buy);
         if(!isSell && !isBuy) { runStart++; continue; }
         int runEnd = runStart;
         while(runEnd + 1 < stepsNum) {
            int li2 = lvl_indices[runEnd + 1];
            bool nextSell = (li2 >= 0 && li2 < g_bars[bi].level_count && g_bars[bi].levels[li2].is_stacked_imb_sell);
            bool nextBuy  = (li2 >= 0 && li2 < g_bars[bi].level_count && g_bars[bi].levels[li2].is_stacked_imb_buy);
            if((isSell && nextSell) || (isBuy && nextBuy)) runEnd++;
            else break;
         }
         int runY = y_tops[runStart];
         int runH = y_tops[runEnd] + InpRowHeightPx - runY;
         color stackCol = isSell ? InpStackedSellColor : InpStackedBuyColor;
         DrawStackRect(x_left, runY, barWidthPx, runH, stackCol);
         runStart = runEnd + 1;
      }

      // Center vertical dotted line (Bid|Ask separator) down middle of column
      DrawCenterLine(x_left + barWidthPx / 2, y_top_first_actual, colHeightPx);

      // Bar separator: thin vertical line between footprint columns
      int sepX = x_left + barWidthPx;
      DrawSeparator(sepX, y_top_first_actual, colHeightPx);
     }

   HideUnusedPool();
   HideUnusedSeparators();
   HideUnusedCenterLines();
   for(int i = g_stackActive; i < g_stackCount; i++)
      ObjectSetInteger(g_chart, g_stackNames[i], OBJPROP_XDISTANCE, -1000);
   for(int i = g_outlineActive; i < g_outlineCount; i++)
      ObjectSetInteger(g_chart, g_outlineNames[i], OBJPROP_XDISTANCE, -1000);
   ChartRedraw();
  }

void ThrottledRender()
  {
   ulong now_ticks = GetTickCount();
   if(now_ticks - g_last_render_ms >= FP_RENDER_THROTTLE_MS) {
      Render();
      g_last_render_ms = now_ticks;
   }
  }

